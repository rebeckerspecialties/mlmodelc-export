program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3600.16.1"}, {"coremlc-version", "3600.25.1"}})]
{
    func main<ios17>(tensor<fp32, [2, 2]> input) {
            tensor<int32, [2]> indices = reduce_argmax(axis = int32(1), keep_dims = bool(false), x = input);
            tensor<fp16, [2, 2]> rounded = cast(dtype = string("fp16"), x = input);
        } -> (indices, rounded);
}
program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3605.1.1"}, {"coremlc-version", "3600.25.1"}})]
{
    func main<ios18>(tensor<fp32, [1, 64]> input) {
            tensor<uint8, [2, 64]> data = const()[val = tensor<uint8, [2, 64]>(BLOBFILE(path = string("@model_path/weights/weights.bin"), offset = uint64(64)))];
            tensor<fp16, [2, 2]> scale = const()[val = tensor<fp16, [2, 2]>(BLOBFILE(path = string("@model_path/weights/weights.bin"), offset = uint64(256)))];
            tensor<uint8, [2, 2]> offset = const()[val = tensor<uint8, [2, 2]>([[128, 128], [128, 128]])];
            tensor<fp16, [2, 64]> weight = constexpr_blockwise_shift_scale(data = tensor<uint8, [2, 64]>(BLOBFILE(path = string("@model_path/weights/weights.bin"), offset = uint64(64))), offset = tensor<uint8, [2, 2]>([[128, 128], [128, 128]]), scale = tensor<fp16, [2, 2]>(BLOBFILE(path = string("@model_path/weights/weights.bin"), offset = uint64(256))));
            tensor<fp16, [1, 64]> input_fp16 = cast(dtype = string("fp16"), x = input);
            bool no = const()[val = bool(false)];
            bool yes = const()[val = bool(true)];
            tensor<fp16, [1, 2]> product = matmul(transpose_x = no, transpose_y = yes, x = input_fp16, y = weight);
            tensor<fp32, [1, 2]> output = cast(dtype = string("fp32"), x = product);
        } -> (output);
}
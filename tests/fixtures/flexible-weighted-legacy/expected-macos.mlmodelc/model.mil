program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3600.16.1"}, {"coremlc-version", "3600.25.1"}})]
{
    func main<ios17>(tensor<fp32, [?, 4]> input) [FlexibleShapeInformation = tuple<tuple<string, dict<string, tensor<int32, [?]>>>, tuple<string, dict<string, list<tensor<int32, [2]>, ?>>>>((("DefaultShapes", {{"input", [1, 4]}}), ("RangeDims", {{"input", [[1, 4], [4, 4]]}})))] {
            tensor<fp32, [4]> weight = const()[val = tensor<fp32, [4]>(BLOBFILE(path = string("@model_path/weights/weights.bin"), offset = uint64(64)))];
            tensor<fp32, [?, 4]> output = add(x = input, y = weight);
        } -> (output);
}
program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3520.4.1"}, {"coremlc-version", "3520.5.1"}})]
{
    func main<ios17>(tensor<fp32, [3, 2]> data, tensor<int32, [?, ?]> indices) [FlexibleShapeInformation = tuple<tuple<string, dict<string, tensor<int32, [?]>>>, tuple<string, dict<string, list<tensor<int32, [2]>, ?>>>>((("DefaultShapes", {{"indices", [2, 4]}}), ("RangeDims", {{"indices", [[0, 2], [0, 4]]}})))] {
            tensor<int32, [?, ?]> output_idx_i32 = cast(dtype = string("int32"), x = indices);
            int32 output_gsz = const()[val = int32(3)];
            int32 output_gszm1 = const()[val = int32(2)];
            int32 output_gz = const()[val = int32(0)];
            tensor<bool, [?, ?]> output_gneg = less(x = output_idx_i32, y = output_gz);
            tensor<int32, [?, ?]> output_gnegi = cast(dtype = string("int32"), x = output_gneg);
            tensor<int32, [?, ?]> output_goff = mul(x = output_gnegi, y = output_gsz);
            tensor<int32, [?, ?]> output_gwrap = add(x = output_idx_i32, y = output_goff);
            tensor<int32, [?, ?]> output_gmx = maximum(x = output_gwrap, y = output_gz);
            tensor<int32, [?, ?]> output_gcl = minimum(x = output_gmx, y = output_gszm1);
            tensor<fp32, [?, ?, 2]> output = gather(axis = int32(0), indices = output_gcl, validate_indices = bool(false), x = data);
        } -> (output);
}
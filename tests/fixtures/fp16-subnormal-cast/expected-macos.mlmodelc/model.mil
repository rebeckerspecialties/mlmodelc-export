program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3600.16.1"}, {"coremlc-version", "3600.25.1"}})]
{
    func main<ios17>(tensor<fp32, [5]> input) {
            tensor<fp16, [5]> half = const()[val = tensor<fp16, [5]>([0x1p-24, 0x1.5p-17, 0x1.ff8p-15, 0x1p-14, -0x1.5p-17])];
            tensor<fp32, [5]> constant = cast(dtype = string("fp32"), x = half);
            tensor<fp32, [5]> output = add(x = input, y = constant);
        } -> (output);
}
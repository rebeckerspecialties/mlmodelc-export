program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3605.1.1"}, {"coremlc-version", "3600.25.1"}})]
{
    func main<ios18>(tensor<fp32, [2, 4]> input) {
            tensor<int8, [2, 4]> data = const()[val = tensor<int8, [2, 4]>(BLOBFILE(path = string("@model_path/weights/weights.bin"), offset = uint64(64)))];
            tensor<fp32, [1, 1]> unit = const()[val = tensor<fp32, [1, 1]>([[0x1p+0]])];
            tensor<fp32, [2, 4]> exact = constexpr_blockwise_shift_scale(data = tensor<int8, [2, 4]>(BLOBFILE(path = string("@model_path/weights/weights.bin"), offset = uint64(64))), scale = tensor<fp32, [1, 1]>([[0x1p+0]]));
            tensor<fp32, [2, 1]> rows = const()[val = tensor<fp32, [2, 1]>([[0x1p-1], [0x1p-2]])];
            tensor<fp32, [2, 4]> scaled = constexpr_blockwise_shift_scale(data = tensor<int8, [2, 4]>(BLOBFILE(path = string("@model_path/weights/weights.bin"), offset = uint64(64))), scale = tensor<fp32, [2, 1]>([[0x1p-1], [0x1p-2]]));
            tensor<fp32, [2, 4]> sum = add(x = exact, y = scaled);
            tensor<fp32, [2, 4]> output = add(x = input, y = sum);
        } -> (output);
}